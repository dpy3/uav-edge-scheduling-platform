# Development configuration template. Copy to .env and replace secrets locally.
FASTAPI_ENV=development
PROJECT_NAME="UAV Edge Scheduling Platform"
SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-local-password
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
